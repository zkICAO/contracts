# Copy to .env and fill in. Every value is this deployment's own: nothing
# here has a working default, because a default domain would put two
# applications in one scope and a default root would anchor to a trust set
# nobody chose.
#
# No key material belongs in this file or any other in the repository. Pass
# the signer to forge with --account against a keystore, or --ledger.

# Your application scope. Any non zero 32 byte value, distinct from every
# other application, since every stored value is hashed against it.
ZKICAO_DOMAIN=<your domain, 0x followed by 64 hex characters>

# The root of the signer registry or master list you publish. See the trust
# registry document for how a relying party builds one.
ZKICAO_REGISTRY_ROOT=<your registry root, 0x followed by 64 hex characters>

# The window of proving dates you accept, as YYYYMMDD. That date decides the
# century of a two digit birth year, so leaving it wide accepts a proof that
# moved a birth date by a hundred years.
ZKICAO_EARLIEST_DATE=<your earliest accepted date, for example 20260101>
ZKICAO_LATEST_DATE=<your latest accepted date, for example 20261231>
